{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // The fixture entry is imported by extension, because its generated `.js`
    // sibling would otherwise win resolution and it holds JSX.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["react", "node"]
  },
  "include": ["src"]
}
