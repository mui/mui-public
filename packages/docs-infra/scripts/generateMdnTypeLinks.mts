/**
 * Generates `src/pipeline/loadServerTypes/mdnTypeLinks.ts` from `@mdn/browser-compat-data`.
 *
 * Run with `pnpm -F @mui/internal-docs-infra generate:mdn-type-links` after bumping the
 * `@mdn/browser-compat-data` dependency.
 */
import * as fs from 'node:fs/promises';
import * as prettier from 'prettier';
import bcd from '@mdn/browser-compat-data' with { type: 'json' };
import type { Identifier } from '@mdn/browser-compat-data';

const MDN_URL_PREFIX = 'https://developer.mozilla.org/docs/';

const OUTPUT_FILE = new URL('../src/pipeline/loadServerTypes/mdnTypeLinks.ts', import.meta.url);

/**
 * Globals that only exist as values, never as type names.
 */
const VALUE_ONLY_GLOBALS = new Set(['Infinity', 'NaN']);

/**
 * Types that only exist in TypeScript's lib declarations and have no MDN page of their own,
 * mapped to the closest MDN section.
 */
const TYPESCRIPT_ONLY_LINKS: Record<string, string> = {
  'Intl.CollatorOptions': 'Web/JavaScript/Reference/Global_Objects/Intl/Collator/Collator#options',
  'Intl.DateTimeFormatOptions':
    'Web/JavaScript/Reference/Global_Objects/Intl/DateTimeFormat/DateTimeFormat#options',
  'Intl.LocalesArgument': 'Web/JavaScript/Reference/Global_Objects/Intl#locales_argument',
  'Intl.NumberFormatOptions':
    'Web/JavaScript/Reference/Global_Objects/Intl/NumberFormat/NumberFormat#options',
};

function isTypeName(name: string): boolean {
  return /^[A-Z]/.test(name) && !VALUE_ONLY_GLOBALS.has(name);
}

/**
 * Lists the child features of `identifier`, without its own `__compat` statement.
 */
function getMembers(identifier: Identifier): [string, Identifier][] {
  return Object.entries(identifier).filter(
    (entry): entry is [string, Identifier] => entry[0] !== '__compat',
  );
}

function getMdnPath(identifier: Identifier): string | undefined {
  // eslint-disable-next-line no-underscore-dangle
  const url = identifier.__compat?.mdn_url;
  return url?.startsWith(MDN_URL_PREFIX) ? url.slice(MDN_URL_PREFIX.length) : undefined;
}

function collectLinks(): Record<string, string> {
  const links: Record<string, string> = {};

  for (const [name, identifier] of getMembers(bcd.api)) {
    const mdnPath = getMdnPath(identifier);
    if (isTypeName(name) && mdnPath) {
      links[name] = mdnPath;
    }
  }

  for (const [name, identifier] of getMembers(bcd.javascript.builtins)) {
    const mdnPath = getMdnPath(identifier);
    if (!isTypeName(name) || !mdnPath) {
      continue;
    }
    links[name] = mdnPath;

    // Namespaced objects such as `Intl.NumberFormat` or `Temporal.PlainDate`
    for (const [memberName, member] of getMembers(identifier)) {
      const memberPath = getMdnPath(member);
      if (
        isTypeName(memberName) &&
        memberName !== name &&
        memberPath?.endsWith(`/${name}/${memberName}`)
      ) {
        links[`${name}.${memberName}`] = memberPath;
      }
    }
  }

  Object.assign(links, TYPESCRIPT_ONLY_LINKS);

  return Object.fromEntries(
    Object.entries(links).sort(([nameA], [nameB]) => (nameA < nameB ? -1 : 1)),
  );
}

async function main() {
  const links = collectLinks();
  // eslint-disable-next-line no-underscore-dangle
  const bcdVersion = bcd.__meta.version;
  const source = `// This file is generated by scripts/generateMdnTypeLinks.mts. Do not edit it manually.
// Data from @mdn/browser-compat-data ${bcdVersion}.

/**
 * Base URL that the paths in \`MDN_TYPE_LINKS\` are relative to.
 */
export const MDN_BASE_URL = '${MDN_URL_PREFIX}';

/**
 * Maps global type names (e.g. \`HTMLElement\`, \`Intl.LocalesArgument\`) to their MDN page,
 * relative to \`MDN_BASE_URL\`.
 */
export const MDN_TYPE_LINKS: Record<string, string> = ${JSON.stringify(links)};
`;

  const filepath = OUTPUT_FILE.pathname;
  const config = await prettier.resolveConfig(filepath);
  await fs.writeFile(OUTPUT_FILE, await prettier.format(source, { ...config, filepath }));
  // eslint-disable-next-line no-console
  console.log(`Wrote ${Object.keys(links).length} links to ${filepath}`);
}

await main();
