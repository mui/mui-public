{
  "name": "@mui/internal-benchmark",
  "version": "0.0.2",
  "author": "MUI Team",
  "description": "Benchmark utilities for MUI projects. Internal package.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mui/mui-public.git",
    "directory": "packages/benchmark"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./ciReport": "./src/ciReport.ts",
    "./reporter": "./src/reporter.ts",
    "./vitest": "./src/vitest.ts",
    "./tachometerPlugin": "./src/tachometer/plugin.ts",
    "./tachometerReport": "./src/tachometer/renderReport.ts",
    "./cli": "./src/cli/index.ts"
  },
  "scripts": {
    "build": "code-infra build --flat --tsgo --bundle esm",
    "typescript": "tsc -noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@pnpm/find-workspace-dir": "^1000.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chalk": "^5.6.2",
    "env-ci": "^11.2.0",
    "execa": "^10.0.1",
    "globby": "^16.2.4",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "@vitest/browser-playwright": ">=4.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vitest": ">=4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/env-ci": "3.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yargs": "17.0.35",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "directory": "build"
  },
  "bin": {
    "benchmark": "./src/cli/index.ts"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
