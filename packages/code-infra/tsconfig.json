{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src"],
  // build-env types the environment of consumers' library sources, not this package's own
  "exclude": ["node_modules", "build", "src/build-env.d.ts"]
}
