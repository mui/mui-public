{
  "private": true,
  "description": "Compares syntax highlighting engines as replacements for Starry Night in @mui/internal-docs-infra",
  "type": "module",
  "scripts": {
    "benchmark": "tsx ./src/run.ts",
    "typescript": "tsc -noEmit",
    "benchmark:disagreements": "tsx ./src/disagreements.ts",
    "benchmark:imports": "tsx ./src/imports.ts"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/common": "^1.5.5",
    "@lezer/css": "^1.3.9",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.8.1",
    "@lezer/yaml": "^1.0.4",
    "@pierre/highlights": "^0.5.1",
    "@types/hast": "^3.0.5",
    "@wooorm/starry-night": "^3.11.0",
    "hast-util-to-html": "9.0.6"
  },
  "devDependencies": {
    "@mui/internal-docs-infra": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.8"
  }
}
